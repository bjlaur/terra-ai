# TerraAI SOPEL Bot Configuration (Test/Integration)
# For use with ergochat on localhost.
# Copy this to sopel-test.cfg and adjust paths.
#
# Note: Uses plaintext 6667 for testing. For production,
# use port 6697 with use_ssl = true and valid TLS certs.

[core]
# IRC connection
nick = TerraAI
host = 127.0.0.1
port = 6667
use_ssl = false

# Owner/admin
owner = agent1

# Channel
channels = #terra-ai-agent1

# Command trigger prefix (use '-' in production)
prefix = -
help_prefix = -

# Only load what we need — TerraAI is the main feature
enable =
    admin
    adminchannel
    ping
    reload
    safety
    tell
    coretasks
    terra_ai

# Extra plugin directory (where terra_ai/ package lives)
# Set to the project root when running from a clone
extra =
    /home/agent/agentic-repos/terra-ai-agent1

[terraai]
# AI provider
model = tencent/hy3:free
api_key = ${OPENROUTER_API_KEY}
base_url = https://openrouter.ai/api/v1
provider_timeout = 30

# Bot behavior
trigger_phrase = TerraAI:
bot_nick = TerraAI
effort = high

# Storage
sqlite_path = data/terraai.db
